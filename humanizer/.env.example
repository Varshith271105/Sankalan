# Copy this file to .env and fill in your own keys. Do NOT commit .env.

# Gemini powers the formal rewrite (fast + faithful). Get a key at:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# OpenRouter is used for translation-laundering and as a fallback.
# Free key: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Optional
GROQ_API_KEY=
